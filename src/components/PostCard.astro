---
import { render } from 'astro:content';
import type { Post } from '../lib/posts';
import { formatPostDate, monthKey } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<article class="post" data-month={monthKey(post.data.pubDate)} id={post.id}>
  <p class="post-date">
    <time datetime={post.data.pubDate.toISOString()}>
      {formatPostDate(post.data.pubDate)}
    </time>
  </p>
  <h2 class="post-title">{post.data.title}</h2>

  {
    post.data.contentType === 'book_review' &&
      (post.data.bookTitle || post.data.bookAuthor) && (
        <p class="book-card">
          {[
            post.data.bookTitle,
            post.data.bookAuthor ? `by ${post.data.bookAuthor}` : null,
            post.data.bookRating
              ? `${'★'.repeat(post.data.bookRating)}${'☆'.repeat(5 - post.data.bookRating)}`
              : null,
          ]
            .filter(Boolean)
            .join(' · ')}
        </p>
      )
  }

  <div class="post-content">
    <Content />
  </div>

  {
    post.data.photos.length > 0 && (
      <div class="post-photos">
        {post.data.photos.map((photo) => (
          <figure class="photo-frame">
            <img src={photo.src} alt={photo.alt || post.data.title} loading="lazy" />
            {photo.caption && <figcaption class="photo-caption">{photo.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }
</article>

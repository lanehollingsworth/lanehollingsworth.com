---
import { render } from 'astro:content';
import type { Post } from '../lib/posts';
import { formatPostDate, monthKey } from '../lib/posts';
import PhotoCarousel from './PhotoCarousel.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const hasBody = Boolean(post.body?.trim());
---

<article class="post" data-month={monthKey(post.data.pubDate)} id={post.id}>
  <p class="post-date">
    <time datetime={post.data.pubDate.toISOString()}>
      {formatPostDate(post.data.pubDate)}
    </time>
  </p>
  <h2 class="post-title">{post.data.title}</h2>

  {
    post.data.contentType === 'book_review' &&
      (post.data.bookTitle || post.data.bookAuthor) && (
        <p class="book-card">
          {[
            post.data.bookTitle,
            post.data.bookAuthor ? `by ${post.data.bookAuthor}` : null,
            post.data.bookRating
              ? `${'★'.repeat(post.data.bookRating)}${'☆'.repeat(5 - post.data.bookRating)}`
              : null,
          ]
            .filter(Boolean)
            .join(' · ')}
        </p>
      )
  }

  {
    hasBody && (
      <div class="post-content">
        <Content />
      </div>
    )
  }

  {
    post.data.photos.length > 0 && (
      <PhotoCarousel photos={post.data.photos} label={`Photos for ${post.data.title}`} />
    )
  }
</article>

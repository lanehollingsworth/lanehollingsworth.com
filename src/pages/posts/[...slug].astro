---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  formatPostDate,
  getPublishedPosts,
  postDescription,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const description = postDescription(post);
---

<BaseLayout
  title={post.data.title}
  description={description}
  canonicalPath={`/posts/${post.id}/`}
  ogType="article"
  pubDate={post.data.pubDate}
>
  <div class="site-shell" style="grid-template-columns: 1fr;">
    <div class="site-main" style="margin: 0 auto;">
      <Header />
      <a class="back-link" href="/">← Back to journal</a>

      <article class="post" style="border-bottom: none; margin-bottom: 0; padding-bottom: 0;">
        <p class="post-date">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatPostDate(post.data.pubDate)}
          </time>
        </p>
        <h1 class="post-title" style="font-size: clamp(1.85rem, 4vw, 2.25rem);">
          {post.data.title}
        </h1>

        {
          post.data.contentType === 'book_review' &&
            (post.data.bookTitle || post.data.bookAuthor) && (
              <p class="book-card">
                {[
                  post.data.bookTitle,
                  post.data.bookAuthor ? `by ${post.data.bookAuthor}` : null,
                  post.data.bookRating
                    ? `${'★'.repeat(post.data.bookRating)}${'☆'.repeat(5 - post.data.bookRating)}`
                    : null,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
            )
        }

        <div class="post-content">
          <Content />
        </div>

        {
          post.data.photos.length > 0 && (
            <div class="post-photos">
              {post.data.photos.map((photo) => (
                <figure class="photo-frame">
                  <img
                    src={photo.src}
                    alt={photo.alt || post.data.title}
                    loading="lazy"
                  />
                  {photo.caption && (
                    <figcaption class="photo-caption">{photo.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          )
        }
      </article>

      <Footer />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    description,
    author: {
      '@type': 'Person',
      name: 'Lane Hollingsworth',
    },
    mainEntityOfPage: `https://lanehollingsworth.com/posts/${post.id}/`,
  })} />
</BaseLayout>

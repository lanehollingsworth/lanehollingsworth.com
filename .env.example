# Copy to .env for local testing (never commit .env)

# --- Publishing API (/write + iOS Shortcut) ---
WRITE_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=lanehollingsworth/lanehollingsworth.com

# --- Decap CMS GitHub OAuth (/admin) ---
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Optional Squarespace DNS automation ---
SQUARESPACE_EMAIL=
SQUARESPACE_PASSWORD=
DOMAIN_NAME=lanehollingsworth.com
# VERCEL_TOKEN=

# Lane Command Center — Google Sheets read-only adapter (2E)
# Values live here only, never in the repository. .env is gitignored.
LCC_GOOGLE_SHEET_ID=
LCC_GOOGLE_OAUTH_CLIENT_ID=
LCC_GOOGLE_OAUTH_CLIENT_SECRET=

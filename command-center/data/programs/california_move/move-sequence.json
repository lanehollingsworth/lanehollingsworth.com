    { "id": "financial_gate", "label": "Run the financial-executability gate", "duration_days": 1, "after": [{ "id": "resolve_terms" }], "gate": "gate_2", "category": "finance", "irreversible": false },
    { "id": "confirm_report_date", "label": "Confirm the target first Glendale reporting date", "duration_days": 1, "after": [{ "id": "resolve_terms" }], "gate": "gate_1", "category": "career", "irreversible": false },
    { "id": "rental_search", "label": "Activate live California rental search", "duration_days": 7, "after": [{ "id": "financial_gate" }], "gate": "gate_3", "category": "ca_housing", "irreversible": false },
    { "id": "mover_quotes", "label": "Refresh mover / container quotes", "duration_days": 7, "after": [{ "id": "financial_gate" }], "gate": "gate_5", "category": "household_move", "irreversible": false },
    { "id": "house_branch_decision", "label": "Select the Orlando house branch", "duration_days": 5, "after": [{ "id": "financial_gate" }], "gate": "gate_4", "category": "house", "irreversible": false, "note": "Only if the evidence exists. A forced branch decision is worse than a deferred one." },
    { "id": "rental_applications", "label": "Apply for top California rentals", "duration_days": 4, "after": [{ "id": "rental_search" }], "gate": "gate_3", "category": "ca_housing", "irreversible": false },
    { "id": "lease_signed", "label": "Sign the California lease", "duration_days": 3, "after": [{ "id": "rental_applications" }, { "id": "confirm_report_date" }], "gate": "gate_3", "category": "ca_housing", "irreversible": true, "note": "First truly irreversible California commitment. Requires final job and location terms." },
    { "id": "book_household_move", "label": "Book the household-goods move", "duration_days": 2, "after": [{ "id": "lease_signed" }, { "id": "mover_quotes" }], "gate": "gate_5", "category": "household_move", "irreversible": true },
    { "id": "dog_travel_prep", "label": "Vet visit, medication trial, records, rehearsal drives", "duration_days": 14, "after": [{ "id": "confirm_report_date" }], "gate": "gate_5", "category": "pets", "irreversible": false, "note": "Starts early on purpose. Medication is trialled before departure, never on day one." },
    { "id": "purge_pack", "label": "Orlando purge, sell, pack and prep", "duration_days": 21, "after": [{ "id": "house_branch_decision" }], "gate": "gate_4", "category": "declutter", "irreversible": false },
    { "id": "orlando_prep_works", "label": "Deep clean, yard, handyman items", "duration_days": 7, "after": [{ "id": "purge_pack" }], "gate": "gate_4", "category": "house", "irreversible": false },
    { "id": "tundra_service", "label": "Pre-trip Tundra service", "duration_days": 3, "after": [{ "id": "book_household_move" }], "gate": "gate_5", "category": "road_trip", "irreversible": false },
    { "id": "utilities_address", "label": "Utilities, address changes, mail forwarding", "duration_days": 3, "after": [{ "id": "lease_signed" }], "gate": "gate_5", "category": "ca_setup", "irreversible": false },
    { "id": "movers_pickup", "label": "Movers pick up household goods", "duration_days": 1, "after": [{ "id": "book_household_move", "lag_days": 14, "lag_reason": "carrier lead time" }, { "id": "purge_pack" }], "gate": "gate_5", "category": "household_move", "irreversible": true },
